name = "Cloudy-ODT"
version = "3.1.2"
license = "GPL-3.0-or-later"
author = "Corey Bois"
maintainer = "corey.bois@utah.edu"
copyright = "Copyright 2025 Corey Bois"
description = "Cloudy-ODT (CODT) is a one-dimensional model of warm-cloud microphysics in turbulent flows. It explicitly tracks the growth, settling, and collision-coalescence of individual Lagrangian cloud droplets while turbulence is represented along a single spatial dimension using the One-Dimensional Turbulence (ODT), replicating the statistics of turbulent flow at lower computational cost. CODT supports two modes: a 'chamber' mode targeting the Pi convection-cloud chamber at Michigan Technological University (Rayleigh-Bénard convection via ODT), and a 'parcel' mode for adiabatic ascent (Linear Eddy Model turbulence with optional entrainment). Together these enable detailed study of the coupling between turbulence, supersaturation fluctuations, and the evolution of cloud droplet size distributions."

[build]
auto-executables = true
auto-tests = false
auto-examples = false
link = ["netcdf", "netcdff"]
external-modules = ["netcdf", "netcdff"]

[library]
source-dir = "src"

[install]
library = false

[dependencies]

# ---------------------------------------------------------------------------
# Build features and profiles
# ---------------------------------------------------------------------------
# All build flags live here. Select a profile at build time:
#
#   ./build.sh                                         # production (-O2)
#   ./build.sh debug                                   # bounds/leak checks
#   ./build.sh profiled                                # release + gprof (-pg)
#
# or equivalently, with the compiler module already loaded:
#
#   fpm build --profile release  --compiler gfortran
#
# Each profile is a list of the features below, and every feature has
# per-compiler flag sets, so gfortran and nvfortran each get their own
# release/debug/profiled flags.
#
# INVARIANT: every profile defined here needs a matching (compiler, profile)
# case in build.sh naming the compiler module to load, because gfortran .mod
# files are not portable across gcc major versions. Add profiles to both files
# or to neither.
#
# NOTE: fpm's own built-in `release`/`debug` (which force -O3 / -O0) are
# overridden by the definitions here. Use -O2 for production: -O3/-flto cause
# instruction-cache pressure in the hot DGM path and run SLOWER (see
# docs/known_issues.md).
# ---------------------------------------------------------------------------

# --- Machine-specific netCDF paths -----------------------------------------
# EDIT THESE in your LOCAL fpm.toml (copy this template to fpm.toml). They are
# the only site-specific values; everything else in this file is portable.
# Layout assumed: ${BASE}/${compilerstack}/netcdf/{include,lib}. The -rpath
# bakes the runtime library path into the binary so it runs without loading
# any module (self-contained -- important for batch/nohup runs).
[features.netcdf-local.gfortran]
flags = "-I/PATH/TO/gcc-X.X.X/netcdf/include"
link-time-flags = "-L/PATH/TO/gcc-X.X.X/netcdf/lib -Wl,-rpath=/PATH/TO/gcc-X.X.X/netcdf/lib"

[features.netcdf-local.nvfortran]
flags = "-I/PATH/TO/nvhpc-XX.X/netcdf/include"
link-time-flags = "-L/PATH/TO/nvhpc-XX.X/netcdf/lib -Wl,-rpath=/PATH/TO/nvhpc-XX.X/netcdf/lib"

# --- Production optimization (-O2) ------------------------------------------
[features.optimized.gfortran]
flags = "-O2 -finline-functions -ffree-line-length-none"

[features.optimized.nvfortran]
flags = "-O2"

# --- Debug (no optimization, runtime checks) --------------------------------
[features.debugging.gfortran]
flags = "-g -O0 -fcheck=all -fbacktrace -ffree-line-length-none"

[features.debugging.nvfortran]
flags = "-g -O0 -Mbounds -traceback"

# --- Profiling instrumentation ----------------------------------------------
# gfortran: gprof (-pg). nvfortran: -Mprof=ccff for pgprof; note the
# profile-codt workflow uses `perf` on the plain release binary, which needs
# no build flags -- profile with --profile release in that case.
[features.profiling.gfortran]
flags = "-pg"
link-time-flags = "-pg"

[features.profiling.nvfortran]
flags = "-Mprof=ccff"
link-time-flags = "-Mprof=ccff"

# --- Optional: architecture-tuned build -------------------------------------
# The `optimized`/`netcdf-local` pair above targets a portable baseline. If
# your cluster has more than one CPU microarchitecture (e.g. Intel + AMD
# nodes in the same partition), or you just want -march tuned to your own
# hardware, add a SEPARATE feature pair + profile per architecture rather
# than editing the baseline in place -- that way the baseline stays safe to
# run anywhere, and an arch-tuned binary is opt-in.
#
# Only CODT's own objects need the -march flag -- point `netcdf-<tag>` at a
# portable netCDF build so nothing on the link line limits where the binary
# runs. The one hard requirement is that it was built with the same compiler
# version you build the profile under: gfortran .mod files are not readable
# across gcc major versions.
#
# The arch-tuning flag itself is compiler-specific -- look up what your
# compiler calls it (site/cluster docs, `man`, or `--help`) and fill in the
# flag AND its value yourself; there's no one true spelling across compilers.
# Site-specific netCDF paths and available builds are likewise something to
# confirm locally. See docs/running_codt.md section 1a.
#
# [features.netcdf-arch.YOUR_COMPILER]
# flags = "-I/PATH/TO/ARCH/netcdf/include"
# link-time-flags = "-L/PATH/TO/ARCH/netcdf/lib -Wl,-rpath=/PATH/TO/ARCH/netcdf/lib"
#
# [features.optimized-arch.YOUR_COMPILER]
# flags = "-O2 --YOUR SPECIFIC COMPILER OPTIMIZATION FLAGS"

[profiles]
release  = ["optimized", "netcdf-local"]
debug    = ["debugging", "netcdf-local"]
profiled = ["optimized", "profiling", "netcdf-local"]
# arch   = ["optimized-arch", "netcdf-arch"]   # uncomment once the features above are filled in

[[executable]]
name = "CODT"
source-dir = "app"
main = "main.f90"
