name = "Cloudy-ODT"
version = "2.0.1"
license = "GPL-3.0-or-later"
author = "Corey Bois"
maintainer = "corey.bois@utah.edu"
copyright = "Copyright 2025 Corey Bois"
description = "Cloudy-ODT (CODT) is a one-dimensional model of warm-cloud microphysics in turbulent flows. It explicitly tracks the growth, settling, and collision-coalescence of individual Lagrangian cloud droplets while turbulence is represented along a single spatial dimension using the One-Dimensional Turbulence (ODT), replicating the statistics of turbulent flow at lower computational cost. CODT supports two modes: a 'chamber' mode targeting the Pi convection-cloud chamber at Michigan Technological University (Rayleigh-Bénard convection via ODT), and a 'parcel' mode for adiabatic ascent (Linear Eddy Model turbulence with optional entrainment). Together these enable detailed study of the coupling between turbulence, supersaturation fluctuations, and the evolution of cloud droplet size distributions."

[build]
auto-executables = true
auto-tests = false
auto-examples = false
link = ["netcdf", "netcdff"]
external-modules = ["netcdf", "netcdff"]

[library]
source-dir = "src"
# Note: include-dir can be handled by shell env variable: FPM_FFLAGS, declared in the script "fpm_env"
# include-dir = "-I/path/to/netcdf/include"

[install]
library = false

[dependencies]

[[executable]]
name = "CODT"
source-dir = "app"
main = "main.f90"
