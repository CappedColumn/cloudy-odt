#!/bin/bash
#
# Environment setup for building CODT with the Fortran Package Manager (fpm).
#
# CODT keeps its build flags in the fpm manifest (fpm.toml features/profiles),
# NOT here. This script's only job is to make your Fortran compiler available
# (on PATH) so that `fpm build --compiler <name>` can find it. The
# machine-specific netCDF paths live in the `netcdf-local` feature of your
# LOCAL fpm.toml (copy fpm.toml.template -> fpm.toml and edit the paths).
#
# CODT's manifest defines flags for gfortran and nvfortran. Select one at build
# time:
#   fpm build --profile release --compiler gfortran
#   fpm build --profile release --compiler nvfortran
#
# NOTE: with environment modules (Lmod), compilers are usually in one "family"
# and are mutually exclusive -- loading nvhpc swaps out gcc, etc. So load the
# ONE compiler you are building with and re-source to switch, rather than
# loading several at once.
#
# Usage:
#   source fpm_env            # gfortran, baseline (default)
#   source fpm_env nvfortran  # if you build with nvfortran, baseline
#   ./build.sh                # production (release) build
#
# --- Optional: architecture-tuned build --------------------------------
# If you added an arch-tuned feature/profile pair to your fpm.toml (see the
# "Optional: architecture-tuned build" comment there), give it a matching
# arch argument here so `source fpm_env <compiler> <arch>` loads whatever
# compiler/module that arch-tuned build actually needs (which may differ
# from your baseline compiler version/module). Keep "baseline" as the
# default so plain `source fpm_env` never needs an arch to be defined.

COMPILER="${1:-gfortran}"
ARCH="${2:-baseline}"

# unload all modules first: 0-false, 1-true
PURGE_MODULES=0
[ "$PURGE_MODULES" = 1 ] && module purge

# ---------------------------------------------------------------------------
# USER SETTINGS -- map each (compiler, arch) pair to its environment module
# (adjust names). Delete a branch you do not have; most users only need
# gfortran/baseline. Add an arch branch only once you've added the matching
# feature/profile pair in fpm.toml.
# ---------------------------------------------------------------------------
case "${COMPILER}:${ARCH}" in
    gfortran:baseline)  module load gcc/X.X.X ;;
    nvfortran:baseline) module load nvhpc/XX.X ;;
    # gfortran:arch)     module load gcc/YOUR.ARCH.VERSION ;;
    *)
        echo "Unknown compiler/arch combo: $COMPILER/$ARCH"
        return 1 2>/dev/null || exit 1
        ;;
esac

# --- No environment modules? -----------------------------------------------
# Put the compiler on PATH yourself, or point fpm at it explicitly:
#   export FPM_FC=/full/path/to/gfortran
#   export PATH=/opt/compiler/bin:$PATH

echo "CODT build env ready: $COMPILER module loaded."
echo "Build:  ./build.sh   |   fpm build --profile release --compiler $COMPILER"
