
&PARAMETERS

! Domain Set-Up
N = 2000        ! Number of Grid Cells
tmax = 100.     ! Maximum Simulation Time (seconds)
Tref = 20.      ! Bottom boundary condition (i.e. warm)
pres = 1.00e5
H = 1.
volume_scaling = 10 ! i.e. 50 -> 50 cm3 Domain Volume

same_random = .false. ! Use the same random number generator seed, for testing primarily

! Input/Output
simulation_name = "CODT_SIM"
output_directory = "output/"
overwrite = .false. ! Allow overwriting existing output files

! Read/write Parameters
write_timer = 1.0 ! Write domain data every X seconds
write_buffer = 100 ! Buffer size, n iterations to write to netCDF
write_eddies = .false.

do_turbulence = .true.
do_microphysics = .true. ! triggers aerosol-droplet processes

do_special_effects = .false. ! Controls special effect namelist below
do_radiation = .false.
do_entrainment = .false.

/

&PARCEL

parcel_file = "parcel_input.nc"
initial_RH = 1.0
vertical_axis = 'height'       ! units of the file's leg targets: 'height' (m) or 'pressure' (Pa)
pressure_mode = 'hydrostatic'  ! 'hydrostatic' (self-integrated) or 'environment' (follow sounding p(z))
initial_height = 0.0           ! parcel launch height (m)

/

&ENTRAINMENT

ent_rate = 2.0             ! fractional entrainment rate (1/km)
n_blob = 1                 ! number of blobs per entrainment event
psigma = 0.1               ! blob fraction of domain per blob
random_entrainment = .true. ! Poisson-randomize entrainment timing

/

&TURBULENCE_ODT
Tdiff = 10.
Lmin = 6
Lprob = 18
max_accept_prob = 0.1
C2 = 1.5e3
ZC2 = 1.0e5
/

&TURBULENCE_LEM
integral_length_scale = 0.01
dissipation_rate = 0.01
/

&MICROPHYSICS

! --- Droplet Injection Parameters ---

init_drop_each_gridpoint = .false.           ! Decreases spin-up time
expected_Ndrops_per_gridpoint = 1.0       ! Set initial size of particle array to prevent reallocation

! Must be greater than 1
initial_wet_radius = 1.5      ! Injected wet radius is # times dry-radius

aerosol_file = "aerosol_input.nc"
aerosol_concentration = 100.0 ! Initial aerosol number concentration (cm-3, parcel mode only)

! --- Aerosol Seeding Parameters ---
! Releases seed aerosol at the events defined in aerosol_file (chamber: at a time,
! parcel: at a height/pressure). do_seeding is the absolute controller: .true.
! requires a seed group in aerosol_file (absent => fatal); .false. ignores any
! seed group present (with a warning). The bundled aerosol_input.nc ships with a
! seed group, so .true. runs it as-is and .false. simply ignores it.

do_seeding = .false.
seed_hydration = 'equilibrium'  ! 'equilibrium' | 'double_growth' | 'dry'; seed material only
seed_growth_time = 5.0          ! Growth time allowed at release, bounds 'equilibrium' (s)

! --- Collision-Coalescence Parameters ---

do_collisions = .false.
do_coalescence = .false.
coalescence_kernel = 'hall'
wmax_collision = 10.0
write_collisions = .false.

! --- Droplet Writeout Parameters ---

write_trajectories = .false.
trajectory_start = 4900.  ! Start time in seconds
trajectory_end = 5401.    ! End time in seconds
trajectory_timer = 1.0 ! How frequently to write particle data

/


&RADIATION

radiation_method = '1d'       ! '1d' (two-stream) or '3d' (Monte Carlo)
mie_data_file = 'mie_absorption.txt'

! Boundary emissivities
eps_top = 1.0
eps_bot = 1.0

! Sky cooling (overrides top boundary with sky_temp)
sky_cooling_flag = .false.
sky_temp = 263.15

! Radiation calling interval (0 = every physics step)
rad_call_interval = 0.0
max_droplets_per_cell = 20

! 3D Monte Carlo parameters (only used when radiation_method = '3d')
nPhotons = 700000
nBins = 30
Lx_rad = 2.0
Ly_rad = 2.0
T_side = 293.15

/

&SPECIALEFFECTS

! Sidewalls
do_sidewalls = .false.
area_sw  = 4 ! Area of sidewalls (m2)
area_bot = 2 ! Area of bottom (m2)
C_sw = 0.42 ! sidewall eddy velocity coefficient (velocity_sw = C_sw * velocity_bot)
sw_nudging_time = 0.85 ! run nudging every X seconds (probably not a common divisor of the scalar field writeout timer)
T_sw = 14.85 ! Sidewall Temperature (C)
RH_sw = 1.0 ! Sidewall Relative Humidity (fraction)
P_sw = 7 ! Sidewall tuning parameter


! Stochastic Fallout - Droplet "Perceived" Height
do_random_fallout = .false.
random_fallout_rate = 1.

/
